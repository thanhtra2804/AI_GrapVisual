# Copy file này sang .env.local và thay đổi giá trị
# DO NOT commit .env.local lên git!

# Groq API Key (lấy từ https://console.groq.com)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Google Cloud Text-to-Speech API Key (Vietnamese voice)
# Lấy từ: https://console.cloud.google.com → Text-to-Speech API → Create API Key
VITE_GOOGLE_TTS_API_KEY=your_google_tts_api_key_here
